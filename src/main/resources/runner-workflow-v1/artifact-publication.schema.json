{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:braidrun:artifact-publication-event:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "publicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\\\u0000]).+$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "childExecutionPath": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,256}$"
      }
    },
    "producerWorkflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producerStep": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producerStartEventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "codeSourceSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "publicationId",
    "artifactId",
    "logicalPath",
    "size",
    "sha256",
    "childExecutionPath",
    "producerWorkflowId",
    "producerStep",
    "producerStartEventId",
    "codeSourceSha256"
  ],
  "additionalProperties": false
}

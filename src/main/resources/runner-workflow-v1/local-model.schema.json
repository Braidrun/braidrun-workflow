{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:braidrun:local-model:v1",
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "ownerId": {
          "type": "string",
          "minLength": 1
        },
        "actorUserId": {
          "type": "string",
          "minLength": 1
        },
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "runnerId": {
          "type": "string",
          "minLength": 1
        },
        "runnerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "resumeEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtimeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "protocolVersion",
        "ownerId",
        "actorUserId",
        "executionId",
        "runnerId",
        "runnerInstanceId",
        "resumeEpoch",
        "attemptId",
        "definitionHash",
        "runtimeHash"
      ],
      "additionalProperties": false
    },
    "localBinding": {
      "type": "object",
      "properties": {
        "runnerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "executionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "endpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$"
        },
        "serviceVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "maximumOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "required": [
        "runnerId",
        "ownerId",
        "executionId",
        "attemptId",
        "endpointId",
        "endpoint",
        "serviceVersion",
        "model",
        "digest",
        "contextTokens",
        "maximumOutputTokens"
      ],
      "additionalProperties": false
    },
    "identityPayload": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/localBinding"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      },
      "required": [
        "binding",
        "requestId"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 131072
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false
    },
    "reservePayload": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/localBinding"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "stepName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "childExecutionPath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 32
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "jsonObject": {
          "type": "boolean"
        }
      },
      "required": [
        "binding",
        "requestId",
        "stepName",
        "childExecutionPath",
        "messages",
        "outputTokens",
        "jsonObject"
      ],
      "additionalProperties": false
    },
    "finishPayload": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/localBinding"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "observation": {
          "enum": [
            "NOT_SENT",
            "SERVICE_REPORTED_DONE",
            "STOP_UNCONFIRMED"
          ]
        }
      },
      "required": [
        "binding",
        "requestId",
        "observation"
      ],
      "additionalProperties": false
    },
    "grantPayload": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/localBinding"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "state": {
          "const": "RESERVED"
        }
      },
      "required": [
        "binding",
        "requestId",
        "state"
      ],
      "additionalProperties": false
    },
    "statusPayload": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/$defs/localBinding"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "state": {
          "enum": [
            "RESERVED",
            "STARTED",
            "RELEASED",
            "QUARANTINED"
          ]
        },
        "released": {
          "type": "boolean"
        }
      },
      "required": [
        "binding",
        "requestId",
        "state"
      ],
      "additionalProperties": false
    },
    "localModelReserveFrame": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "type": {
          "const": "localModelReserve"
        },
        "payload": {
          "$ref": "#/$defs/reservePayload"
        }
      },
      "required": [
        "protocolVersion",
        "frameId",
        "binding",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "localModelCheckFrame": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "type": {
          "const": "localModelCheck"
        },
        "payload": {
          "$ref": "#/$defs/identityPayload"
        }
      },
      "required": [
        "protocolVersion",
        "frameId",
        "binding",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "localModelStartedFrame": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "type": {
          "const": "localModelStarted"
        },
        "payload": {
          "$ref": "#/$defs/identityPayload"
        }
      },
      "required": [
        "protocolVersion",
        "frameId",
        "binding",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "localModelFinishFrame": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "type": {
          "const": "localModelFinish"
        },
        "payload": {
          "$ref": "#/$defs/finishPayload"
        }
      },
      "required": [
        "protocolVersion",
        "frameId",
        "binding",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "localModelGrantFrame": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "type": {
          "const": "localModelGrant"
        },
        "payload": {
          "$ref": "#/$defs/grantPayload"
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "protocolVersion",
        "frameId",
        "binding",
        "type",
        "payload",
        "replyTo"
      ],
      "additionalProperties": false
    },
    "localModelStatusFrame": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "type": {
          "const": "localModelStatus"
        },
        "payload": {
          "$ref": "#/$defs/statusPayload"
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "protocolVersion",
        "frameId",
        "binding",
        "type",
        "payload",
        "replyTo"
      ],
      "additionalProperties": false
    }
  }
}
